{
  "name": "xvii/satelles-omnia-roga",
  "description": "Generador de consultas SQL.",
  "license":     "MIT",
  "homepage":    "https://github.com/Tabula17/satelles-omnia-roga",
  "keywords":    ["db", "pdo", "sql", "querybuilder"],
  "authors": [
    {
      "name": "Martín Panizzo",
      "email": "code.tabula17@gmail.com"
    }
  ],
  "extra": {
    "branch-alias": {
      "dev-main": "1.0.x-dev"
    }
  },
  "autoload": {
    "psr-4": {
      "Tabula17\\Satelles\\Omnia\\Roga\\": "src/"
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://tabula17.repo.repman.io"
    }
  ],
  "minimum-stability": "dev",
  "require": {
    "php": ">=8.4",
    "ext-zip": "*",
    "ext-fileinfo": "*",
    "ext-dom": "*",
    "ext-simplexml": "*",
    "xvii/satelles-utilis-proelio": "@dev",
    "xvii/satelles-nexus-utilis": "@dev",
    "ext-bcmath": "*"
  },
  "require-dev": {
    "swoole/ide-helper": "@dev",
    "monolog/monolog": "^3.0@dev",
    "bramus/monolog-colored-line-formatter": "dev-master"
  },
  "suggest": {
    "ext-redis": "Redis extension for caching",
    "ext-memcached": "Memcached extension for caching",
    "monolog/monolog": "Logging"
  }
}
